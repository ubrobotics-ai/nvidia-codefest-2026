diff --git a/src/misc/dist_utils.py b/src/misc/dist_utils.py
index 959ded6..9b389d0 100644
--- a/src/misc/dist_utils.py
+++ b/src/misc/dist_utils.py
@@ -44,7 +44,8 @@ def setup_distributed(
         WORLD_SIZE = int(os.getenv("WORLD_SIZE", 1))
 
         # torch.distributed.init_process_group(backend=backend, init_method='env://')
-        torch.distributed.init_process_group(init_method="env://")
+        # UBR local patch: faster_coco_eval all_gathers CPU tensors, so CPU needs a Gloo backend too.
+        torch.distributed.init_process_group(backend="cpu:gloo,cuda:nccl", init_method="env://")
         torch.distributed.barrier()
 
         rank = torch.distributed.get_rank()
diff --git a/src/misc/profiler_utils.py b/src/misc/profiler_utils.py
index 84db32a..1829930 100644
--- a/src/misc/profiler_utils.py
+++ b/src/misc/profiler_utils.py
@@ -14,6 +14,11 @@ def stats(
 ) -> Tuple[int, dict]:
     base_size = cfg.train_dataloader.collate_fn.base_size
     input_shape = (1, 3, base_size, base_size)
+    # UBR local patch: a non-square eval_spatial_size builds position embeddings for that shape,
+    # so a square dummy input fails (400 vs 880 tokens at 704x1280). Profile at the configured size.
+    ess = cfg.yaml_cfg.get("eval_spatial_size")
+    if ess:
+        input_shape = (1, 3, int(ess[0]), int(ess[1]))
 
     model_for_info = copy.deepcopy(cfg.model).deploy()
 
diff --git a/src/solver/det_solver.py b/src/solver/det_solver.py
index 96b9376..a445621 100644
--- a/src/solver/det_solver.py
+++ b/src/solver/det_solver.py
@@ -68,6 +68,10 @@ class DetSolver(BaseSolver):
                 self.train_dataloader.sampler.set_epoch(epoch)
 
             if epoch == self.train_dataloader.collate_fn.stop_epoch:
+                # UBR local patch: rank 0 writes best_stg1.pth to shared storage with no barrier, so

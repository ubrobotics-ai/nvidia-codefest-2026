__pycache__/
*.pyc
.venv/
.env

# Datasets: never commit frames, clips or model artefacts — keep the placeholder READMEs.
data/*
!data/README.md
!data/real_frames/
!data/synthetic/
data/real_frames/*
!data/real_frames/README.md
data/synthetic/*
!data/synthetic/README.md

# Frozen frame-id slices ARE tracked -- they are lists of filenames, not images, and every bake-off number is
# meaningless without them. The frames they name stay ignored above.
!data/slices/
!data/slices/*.csv
!data/slices/*.json
!data/slices/README.md

*.engine
*.plan
*.nemo
*.gguf
checkpoints/
outputs/
*.log
.DS_Store
